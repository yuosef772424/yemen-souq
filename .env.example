APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# جذر القرص العام. اتركه فارغاً محلياً (يقع إلى storage/app/public).
# وفي الإنتاج على منصة بنظام ملفات مؤقّت اضبطه على مسار قرص دائم
# — وإلا مُحيت صور الإعلانات مع كل نشر. انظر docs/architecture/deployment.md
# FILESYSTEM_PUBLIC_ROOT=/data/public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# مطفأ افتراضياً. ولّد السرّ بـ`php artisan sms:token` قبل التفعيل —
# انظر app/Modules/Sms/Worker/souq-sms-worker.sh لإعداد عامل تيرمكس.
SMS_ENABLED=false
SMS_WORKER_TOKEN=
SMS_DEFAULT_CHANNEL=sms
# SMS_FAILOVER_SMS=whatsapp
# SMS_FAILOVER_WHATSAPP=
# SMS_INBOUND_ENABLED=false
# SMS_INBOUND_NUMBER=
# SMS_INBOUND_PREFIX=SQ
# WHATSAPP_DRIVER=log
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TOKEN=

VITE_APP_NAME="${APP_NAME}"
