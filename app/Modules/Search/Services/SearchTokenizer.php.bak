<?php

namespace App\Modules\Search\Services;

use App\Modules\Shared\Services\ArabicNormalizer;

/**
 * تقطيع استعلام البحث إلى كلمات ذات قيمة تمييزية.
 *
 * لماذا صنف منفصل ولم تُضَف كلمات الوقف إلى ArabicNormalizer:
 * الـNormalizer يكتب الأعمدة المخزَّنة (title_normalized, description_normalized).
 * لو حذف كلمات الوقف من النص المخزَّن، فعنوان «شقة للإيجار في حدة» يُخزَّن
 * ناقصاً، وتنكسر مطابقة العبارة الكاملة إلى الأبد ولا سبيل لاستعادتها بلا
 * إعادة فهرسة. حذف كلمات الوقف قرار خاص بالاستعلام لا بالتخزين — ومكانه
 * وحدة البحث. النص المخزَّن يبقى كاملاً.
 */
final class SearchTokenizer
{
    /**
     * كلمات وظيفية بلا قيمة تمييزية — مكتوبة بصيغتها بعد التطبيع
     * (أ/إ/آ ← ا، ة ← ه، ى ← ي)، لأن المقارنة تجري بعد التطبيع لا قبله.
     *
     * ما استُثني بقصد: «للبيع» و«للايجار» و«مطلوب» و«مستعمل» و«جديد».
     * هي شائعة جداً وتبدو مرشّحة طبيعية للحذف، لكن حذفها يجعل
     * «شقة للإيجار» تطابق «شقة للبيع» — وهذا في العقار خطأ فادح لا
     * تحسيناً. القاعدة: تُحذف الكلمة إن كانت بلا معنى، لا إن كانت شائعة.
     */
    private const STOP_WORDS = [
        'في', 'من', 'الي', 'علي', 'عن', 'مع', 'او', 'ثم', 'حتي',
        'ان', 'انه', 'اني', 'كان', 'كانت', 'يكون', 'ايضا', 'جدا',
        'هذا', 'هذه', 'ذلك', 'تلك', 'الذي', 'التي', 'الذين',
        'هو', 'هي', 'هم', 'انا', 'نحن', 'انت',
        'له', 'لها', 'به', 'بها', 'فيه', 'فيها', 'عليه', 'عليها',
        'عند', 'لدي', 'بعد', 'قبل', 'كل', 'بعض', 'اي', 'ما', 'لا',
        'قد', 'هل', 'يوجد', 'توجد', 'وايضا', 'ولكن', 'لكن',
    ];

    /**
     * سقف عدد الكلمات.
     *
     * كل كلمة تُترجم إلى شرطي LIKE (عنوان أو وصف). لصق فقرة كاملة في
     * صندوق البحث يولّد عشرات الشروط على استعلام لا يستخدم الفهرس أصلاً —
     * صفحة عامة لا يجوز أن يُبطئها زائر بجملة طويلة.
     */
    private const MAX_TOKENS = 8;

    public function __construct(
        private readonly ArabicNormalizer $normalizer,
    ) {
    }

    /**
     * كلمات الاستعلام بعد التطبيع وحذف كلمات الوقف.
     *
     * @return array<int, string>
     */
    public function tokens(?string $query): array
    {
        $all = $this->normalizer->tokenize($query);

        if ($all === []) {
            return [];
        }

        $meaningful = array_values(array_filter(
            $all,
            fn (string $token): bool => ! in_array($token, self::STOP_WORDS, true),
        ));

        // استعلام كامله كلمات وقف («هل يوجد») يبقى كما هو.
        // لو أرجعنا مصفوفة فارغة لسقط شرط النص كلياً وعادت كل الإعلانات —
        // والمستخدم يقرأ ذلك كعطل، لا كتساهل.
        if ($meaningful === []) {
            $meaningful = $all;
        }

        return array_slice($meaningful, 0, self::MAX_TOKENS);
    }

    /**
     * الاستعلام كعبارة واحدة مطبّعة — تُستخدم لأعلى مستوى صلة.
     * كلمات الوقف تبقى فيها: العبارة الحرفية هي ما كتبه المستخدم.
     */
    public function phrase(?string $query): string
    {
        return $this->normalizer->normalize($query);
    }
}